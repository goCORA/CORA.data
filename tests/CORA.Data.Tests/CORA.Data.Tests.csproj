<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Same version as CORA.App; needed by the linked MailBodyText below. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- CORA.Core is a sibling repository: clone it next to CORA.Data. -->
    <ProjectReference Include="..\..\..\CORA.Core\CORA.Core.csproj" />
    <ProjectReference Include="..\..\CORA.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Sources from CORA.App, LINKED (compiled into this assembly) for the tests in App\. CORA.App multi-targets
      MAUI and cannot be referenced from a plain net10.0 project, so only MAUI-free files may be linked here:
      no Preferences, MainThread, Shell, ... - take an interface such as IPreferenceStore instead.
      CORA.App is a sibling repository: clone it next to CORA.Data (like CORA.Core above).
    -->
    <Compile Include="..\..\..\CORA.App\Services\AI\AiProviderType.cs" Link="App\Linked\AiProviderType.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\AiProviderException.cs" Link="App\Linked\AiProviderException.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\AiConsentRequiredException.cs" Link="App\Linked\AiConsentRequiredException.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\AiConsent.cs" Link="App\Linked\AiConsent.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\MailBodyText.cs" Link="App\Linked\MailBodyText.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\EmailActionRiskDecider.cs" Link="App\Linked\EmailActionRiskDecider.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\StructuredAiResults.cs" Link="App\Linked\StructuredAiResults.cs" />
    <Compile Include="..\..\..\CORA.App\Services\AI\AiErrorMessages.cs" Link="App\Linked\AiErrorMessages.cs" />
  </ItemGroup>

  <!-- Rust core: copy the Windows library next to the tests (debug build first, else the release build in dist). -->
  <PropertyGroup>
    <CoraRustDll Condition="Exists('..\..\..\CORA.Core_rust\target\debug\cora_core.dll')">..\..\..\CORA.Core_rust\target\debug\cora_core.dll</CoraRustDll>
    <CoraRustDll Condition="'$(CoraRustDll)' == '' And Exists('..\..\..\CORA.Core_rust\dist\windows\win-x64\cora_core.dll')">..\..\..\CORA.Core_rust\dist\windows\win-x64\cora_core.dll</CoraRustDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(CoraRustDll)' != ''">
    <None Include="$(CoraRustDll)" Link="cora_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
